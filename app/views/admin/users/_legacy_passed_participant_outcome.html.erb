<div class="govuk-summary-card">
  <div class="govuk-summary-card__title-wrapper">
    <h2 class="govuk-summary-card__title">Legacy outcome</h2>
  </div>

  <div class="govuk-summary-card__content">
    <%=
      govuk_summary_list do |summary_list|
        summary_list.with_row do |row|
          row.with_key { "Course" }
          row.with_value { legacy_passed_participant_outcome.course_name }
        end
        summary_list.with_row do |row|
          row.with_key { "TRN" }
          row.with_value { legacy_passed_participant_outcome.trn }
        end
        summary_list.with_row do |row|
          row.with_key { "Completion date" }
          row.with_value { legacy_passed_participant_outcome.completion_date.to_date.to_formatted_s(:govuk) }
        end
      end
    %>
  </div>
</div>
