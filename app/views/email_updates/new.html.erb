<div class="govuk-grid-row">
  <div class="govuk-grid-column">
    <% if Feature.registration_closed?(current_user) %>
      <h1 class="govuk-heading-l">Get email updates about registration opening</h1>
    <% else %>
      <h1 class="govuk-heading-l">Get email updates</h1>
      <p class="govuk-body">We’ll let you know when registration opens for courses starting in autumn 2026</p>
    <% end %>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column">
    <%= form_for @registration_interest, url: email_updates_path do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_text_field :email,
        width: "one-half",
        label: { size: "m", tag: "h2" } %>

      <%= f.govuk_collection_radio_buttons :course,
          f.object.course_options,
          :value,
          :label
      %>

      <p class="govuk-body">By requesting email updates, you agree to our <a class="govuk-link" href="/privacy-policy">privacy notice</a></p>

      <%= f.govuk_submit('Request email updates') %>
    <% end %>
  </div>
</div>
