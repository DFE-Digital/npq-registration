<%=
  form.govuk_text_field(
    question.name,
    **{width: "full",
       label:  { text: question.question_text, size: "l", tag: "h1" }
    }.deep_merge(question.style_options)
  )
%>

<% if question.additional_info %>
  <%=
  render(
    "registration_wizard/shared/additional_info",
  )
  %>
<% end %>
