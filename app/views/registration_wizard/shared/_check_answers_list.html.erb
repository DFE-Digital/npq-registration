<%= render GovukComponent::SummaryListComponent.new do |component|
      if @wizard.is_a?(Registration::Wizard)
        @form.answers.each do |answer|
          component.with_row do |row|
            row.with_key { answer.label }
            row.with_value { answer.formatted_value }
            row.with_action(
              text: "Change",
              href: row.change_path,
              visually_hidden_text: row.label.downcase
            )
          end
        end
      else
        @wizard.answers.each do |answer|
          component.with_row do |row|
            row.with_key { answer.key }
            row.with_value do
              if answer.tag_colour
                govuk_tag(text: answer.value, colour: answer.tag_colour)
              else
                answer.value
              end
            end
            if answer.changeable
              row.with_action(
                text: "Change",
                visually_hidden_text: answer.key,
                href: answer.action_href,
              )
            end
          end
        end
      end
end %>
