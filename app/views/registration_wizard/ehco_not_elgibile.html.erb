<%=
  render(
    'registration_wizard/shared/ehco_not_elgible',
    form: @form,
    wizard: @wizard,
  ) do
%>
  <h1 class="govuk-heading-xl" >Funding elgibility</h1>

  <p class="govuk-body">
    You’re not eligible for the scholarship funding for the <%= localise_sentence_embedded_course_name(Course.ehco) %> (EHCO).
  </p>

  <p class="govuk-body">
    This means that you would need to pay for the EHCO another way
  </p>

  <%= form_with model: @form, url: registration_wizard_form_url(@form), scope: 'registration_wizard', method: :patch do |f| %>
    <%= f.govuk_submit "Continue" %>
  <% end %>
<% end %>
