<% if @form.show_previously_funded_alert? %>
  <%= govuk_notification_banner(title_text: "Important") do |banner| %>
    <% banner.with_heading(text: "Our records show that you have previously received funding for this course. This means you are not eligible for further funding.") %>
  <% end %>
<% end %>

<%=
  render(
    'registration_wizard/shared/questions_page',
    form: @form,
    wizard: @wizard,
  )
%>
